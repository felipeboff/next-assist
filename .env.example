# Copy to .env and fill in. Never commit .env.

# PostgreSQL started by `docker compose up -d` (see compose.yaml).
# Change POSTGRES_PORT and the port below together if 5432 is taken on your machine.
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo_assist

# BetterAuth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Public URL of the app (the dev server by default).
BETTER_AUTH_URL=http://localhost:3000
